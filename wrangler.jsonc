{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anyworkflow-remote",
  "main": "worker/index.ts",
  "tsconfig": "tsconfig.worker.json",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    { "binding": "PDF_UPLOADS", "bucket_name": "anyworkflow-ocr-relay" },
    { "binding": "LIBRARY_FILES", "bucket_name": "anyworkflow-library" }
  ],
  "services": [
    { "binding": "FILE_CONVERTER", "service": "anyworkflow-file-converter" }
  ],
  "vars": {
    "POCKETBASE_URL": "https://pb.any1.tech",
    "PDF_PUBLIC_BASE_URL": "https://ocr-files.any1.tech"
  },
  "secrets": { "required": ["UPLOAD_TICKET_SECRET"] },
  "env": {
    "preview": {
      "name": "anyworkflow-remote-preview",
      "r2_buckets": [
        { "binding": "PDF_UPLOADS", "bucket_name": "anyworkflow-ocr-relay" },
        { "binding": "LIBRARY_FILES", "bucket_name": "anyworkflow-library-preview" }
      ],
      "services": [{ "binding": "FILE_CONVERTER", "service": "anyworkflow-file-converter" }],
      "vars": {
        "POCKETBASE_URL": "https://pb.any1.tech",
        "PDF_PUBLIC_BASE_URL": "https://ocr-files.any1.tech"
      },
      "secrets": { "required": ["UPLOAD_TICKET_SECRET"] }
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
