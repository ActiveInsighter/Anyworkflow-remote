{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anyworkflow-file-converter",
  "main": "converter-worker/index.ts",
  "tsconfig": "tsconfig.converter.json",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "POCKETBASE_URL": "https://pb.any1.tech",
    "GITHUB_FILE_CONVERTER_REPOSITORY": "ActiveInsighter/file-converter-ai",
    "GITHUB_FILE_CONVERTER_WORKFLOW": "pdf-to-md.yml",
    "CONVERTER_ENABLED": "true"
  },
  "secrets": { "required": ["POCKETBASE_SERVER_TOKEN", "GITHUB_FILE_CONVERTER_TOKEN"] },
  "durable_objects": {
    "bindings": [{ "name": "CONVERSION_COORDINATOR", "class_name": "ConversionCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversionCoordinator"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
