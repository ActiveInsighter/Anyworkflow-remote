{
  "name": "anyworkflow-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types scripts/run-tests.mjs && npm run test:worker",
    "test:worker": "node scripts/upload-worker.test.mjs && node scripts/upload-worker-multipart.test.mjs && node scripts/upload-worker-relay.test.mjs && node scripts/converter-worker.test.mjs && node scripts/download-worker.test.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:install": "playwright install chromium",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.converter.json",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "converter:types": "wrangler types --config wrangler.converter.jsonc --env-interface ConverterEnv converter-worker/worker-configuration.d.ts",
    "converter:deploy": "npm run preflight && wrangler deploy --config wrangler.converter.jsonc",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run preflight && wrangler deploy",
    "preflight": "npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "5.20261012.1-beta",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "workerd": "1.20261024.1"
  }
}
