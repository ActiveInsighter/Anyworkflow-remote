{
  "name": "anyworkflow-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types scripts/run-tests.mjs && npm run test:worker",
    "test:worker": "node scripts/upload-worker.test.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:install": "playwright install chromium",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run preflight && wrangler deploy",
    "preflight": "npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "miniflare": "5.20261012.1-beta",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.0",
    "wrangler": "4.151.1"
  }
}
